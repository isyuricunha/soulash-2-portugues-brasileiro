{
  "corrections": [
    {
      "EN": "I sssee you.",
      "after": "Esstou vendo você.",
      "before": "Esss... te vejo!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-c473661b145084ab4d4e3b4a"
    },
    {
      "EN": "I ssswore to protect!",
      "after": "Eu jurrei proteger!",
      "before": "Esss... jurei proteger!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d777ee29c61e8b73a9f55bea"
    },
    {
      "EN": "I will beat you to a pulp!",
      "after": "Vou te bater até virar mingau!",
      "before": "Vou te bater até virar polpa!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-433f68a4d1cb6487e67b9a58"
    },
    {
      "EN": "I will burn you to the ground.",
      "after": "Vou te queimar até não restar nada.",
      "before": "Vou te queimar até o chão.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-3d9df4b30d2c616bfaf8a9c3"
    },
    {
      "EN": "I will feast on your remains.",
      "after": "Vou me banquetear com seus restos.",
      "before": "Vou me banqueteaar com seus restos.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-2fd4b97faf813c4f21141b6e"
    },
    {
      "EN": "I will leave your remains to the vultures.",
      "after": "Deixarei seus restos para os abutres.",
      "before": "Deixarei seus restos para os urubus.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-cf33ac28fe5c8f6ee89e2638"
    },
    {
      "EN": "I will ssshow you what I got!",
      "after": "Vou te mosstrar do que sou capaz!",
      "before": "Eu vou mmmostrar o que eu tenho!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-07b75807cb7b96c50a3bdec1"
    },
    {
      "EN": "I will swallow your sssoul...",
      "after": "Vou engolir sua alma, sssim...",
      "before": "Vou engolir sua almasss...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9a04ac71a7dd9d99bfd582fd"
    },
    {
      "EN": "I will teach you how you should behave!",
      "after": "Vou te ensinar como se comportar!",
      "before": "Vou te ensinar como se deve comportar!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-e9b4d00c8d338ab6c9069435"
    },
    {
      "EN": "I'll feast on your flesh!",
      "after": "Vou me banquetear com sua carne!",
      "before": "Banquetearei com sua carne!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-f1871fb78bf48f59424e7dc1"
    },
    {
      "EN": "I'll feat on ye bones.",
      "after": "Vou me banquetear com teus ossos.",
      "before": "Vou banquetear nos teus ossos.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-2363f5b09f2e54e417766089"
    },
    {
      "EN": "I'm doing fine, thank you. What brings you here?",
      "after": "Estou bem, agradeço. O que traz você aqui?",
      "before": "Estou bem, obrigado. O que o traz aqui?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4bb0ee96dcad5437fd133d91"
    },
    {
      "EN": "I'm gonna rip yer arms off and twist yer guts.",
      "after": "Vou arrancar teus braços e torcer tuas tripas.",
      "before": "Vou arrancar seus braço e torcer sua tripa.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6fcda0089bdd0ef06104ecde"
    },
    {
      "EN": "I'm not ssscared of you!",
      "after": "Não vou me asssustar com você!",
      "before": "Não tô com medooo de você!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-46831648b1fa6f4b30f42e3a"
    },
