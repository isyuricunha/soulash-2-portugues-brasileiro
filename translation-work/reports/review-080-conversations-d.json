{
  "corrections": [
    {
      "EN": "Got a question, or you just wastin' my time?",
      "after": "Tem alguma pergunta ou só tá me fazendo perder tempo?",
      "before": "Tem alguma pergunta ou só tá perdendo meu tempo?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b09485be665e73f0de928c5b"
    },
    {
      "EN": "Great! I can tell you ssso much about blueberries!",
      "after": "Ótimo! Posssso te contar tanta coisa sobre mirtilos!",
      "before": "Ótimo! Posso te contar taaanto sobre mirtilos!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b67c3aae90a6660df9c07a95"
    },
    {
      "EN": "Ha ha ha! That'sss really funny. No.",
      "after": "Ha ha ha! Issso é muito engraçado. Não.",
      "before": "Ha ha ha! Isso é muuito engraçado. Não.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-ca6a478cbfcb8888b31f4c29"
    },
    {
      "EN": "Ha! You woudn't lassst a day. I won't wassste my time on you.",
      "after": "Ha! Você não resssistiria nem um dia. Não vou desssperdiçar meu tempo com você.",
      "before": "Ha! Você não duraria nem um dia. Não vou desperdiçar meu tempo com você",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d219a3b405b2d149869e020f"
    },
    {
      "EN": "Have you seen a bat around here? We think we lost one.",
      "after": "Viu algum morcego por aqui? Achamos que perdemos um.",
      "before": "Viu algum morcego por aqui? Acho que perdemos um.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7db41136cc65eaa9e79b2b4d"
    },
    {
      "EN": "Hmph, you better be worth my time!",
      "after": "Hmpf, é bom você fazer valer meu tempo!",
      "before": "Hmpf, você mais vale valer a pena!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7daaf483563c3324fc57bde8"
    },
    {
      "EN": "Hope it makesss your life a lot sssweeter.",
      "after": "Essspero que isso torne sua vida muito mais doce.",
      "before": "Essspero que isso torne sua vida muito mais docssse.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-023d1bab6f6418690ea1e064"
    },
    {
      "EN": "Hope you put it to good ussse.",
      "after": "Espero que faça bom ussso disso.",
      "before": "Espero que faça bom ussso disso",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-64f5264e3e20c505ecb59015"
    },
    {
      "EN": "Hoy there! Careful with them branches, they're known to snap back!",
      "after": "Ei, você aí! Cuidado com esses galhos, eles costumam bater de volta!",
      "before": "Ei, lá! Cuidado com esses galhos, eles costumam estalar de volta!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-f5a0b9c8e19f2128aa83240f"
    },
    {
      "EN": "I admire your courage. Perhaps I'll take you under my wing.",
      "after": "Admiro sua coragem. Talvez eu coloque você sob minha proteção.",
      "before": "Admiro sua coragem. Talvez eu o leve sob minha asa.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9990b3af6aed8527e27df09c"
    }
  ],
