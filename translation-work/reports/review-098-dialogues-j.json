{
  "corrections": [
    {
      "EN": "What a miserable affair.",
      "after": "Que situação lamentável.",
      "before": "Que assunto miserável.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-ba7a56f2fc75d82b2eec6394"
    },
    {
      "EN": "What's yer aim, eh?",
      "after": "Qual é tua intenção, hein?",
      "before": "Qual é tua intenção, ein?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4b3e4ea96c325fc0eda3d678"
    },
    {
      "EN": "Why are the guards not doing anything?",
      "after": "Por que os guardas não fazem nada?",
      "before": "Por que as guardas não fazem nada?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-3af367a992656540b56ae5f7"
    },
    {
      "EN": "Ydych chi ar goll?",
      "after": "Ydych chi ar goll?",
      "before": "Você está perdido?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-49ca3088782f09296ec62c81"
    },
    {
      "EN": "Yesss, sssir!",
      "after": "Sssim, sssenhor!",
      "before": "Yesss, sssenhor!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-913dcacce26d381772429686"
    },
    {
      "EN": "You came to the wrong dwarves fella!",
      "after": "Você veio procurar os anões errados, cara!",
      "before": "Você veio nos anões errados, cara!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b4ecd4d7649a88cc4275b92b"
    },
    {
      "EN": "You stand before ::short_name! State your business and make it quick.",
      "after": "Você está diante de ::short_name! Diga o que quer e seja breve.",
      "before": "Você está diante de ::short_name! Diga seu negócio e seja rápido.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-620fb7530eb6c886cc2135c2"
    },
    {
      "EN": "You tread too loud. The roots are listening.",
      "after": "Seus passos fazem barulho demais. As raízes estão ouvindo.",
      "before": "Você pisa alto demais. As raízes estão ouvindo.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9e18d8d6ac802f347362dad9"
    }
  ],
