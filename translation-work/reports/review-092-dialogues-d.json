{
  "corrections": [
    {
      "EN": "How do you like it here?",
      "after": "O que você acha daqui?",
      "before": "Como você gosta daqui?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-598318d0bba89d8ce71dff71"
    },
    {
      "EN": "I am Loran, the price of elves.",
      "after": "Sou Loran, o príncipe dos elfos.",
      "before": "Sou Loran, o preço dos elfos.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d62ba924c6b0cd960759a56e"
    },
    {
      "EN": "I could teach you a trick or two about carpentin'",
      "after": "Posso te ensinar um truque ou dois sobre carpintaria.",
      "before": "Posso te ensinar um truque ou dois sobre carpintaria,",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-c0b546350fd4dfe8945ee2de"
    },
    {
      "EN": "I don't perceive thou wishes to discourse upon our lord and saviour, the Stork?",
      "after": "Não desejais conversar sobre nossa senhora e salvadora, a Cegonha?",
      "before": "Não percebo que desejais discorrer sobre nosso senhor e salvador, a Cegonha?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9d74fb9085c579eb5e737ea1"
    },
    {
      "EN": "I dueled my best friend for the hand of my loved one.",
      "after": "Dueliei com meu melhor amigo pela mão de quem eu amava.",
      "before": "Dueliei com meu melhor amigo pela mão da minha amada.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7855cfceeaf6b03cee3d30bd"
    },
    {
      "EN": "I got you now!",
      "after": "Agora te peguei!",
      "before": "Viajei por todo lugar, mas nunca encontrei uma besta como você.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-49c37ce796b16bece7c812e2"
    },
    {
      "EN": "I have traveled far and wide, but I have not met a beast like you.",
      "after": "Viajei por toda parte, mas nunca encontrei uma fera como você.",
      "before": "Sua vinda ao nosso reino foi predita.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-52a8ca88f90aacb969f6cb35"
    },
    {
      "EN": "I like when everything hasss itsss place.",
      "after": "Gosssto quando tudo tem sseu lugar.",
      "before": "Gossssto quando tuddo tem sseu lugar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9577c063bbb16c385328f6d5"
    },
    {
      "EN": "I missed it.",
      "after": "Errei.",
      "before": "Senti falta disso.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7094c662f34970ec094e99df"
    },
    {
      "EN": "I prefer tinkerin' than talkin', so if you ain't buyin'...",
      "after": "Prefiro mexer com engenhocas a conversar, então, se não vai comprar...",
      "before": "Prefiro fuçar do que falar, então se não vai comprar...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4077dd9c36bb7967a42b74d4"
    },
    {
      "EN": "I shape dreams and warmth with every twist.",
      "after": "Eu moldo sonhos e calor a cada torção.",
      "before": "Eu moldeio sonhos e calor a cada torção.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-c32364fcf5cfaf28ecf5ee06"
    }
  ],
