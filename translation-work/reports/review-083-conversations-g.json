{
  "corrections": [
    {
      "EN": "I've ssseen wondersss beyond imagining. I've alssso ssslept in a lot of ditchesss.",
      "after": "Vi maravilhasss além da imaginação. Também dormi em muitas valasss.",
      "before": "Vi maravilhas além da imaginação. Tamém dormi em muitas valasss.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7f3b8a55fbb10e338cc1bc44"
    },
    {
      "EN": "If one hasss coinsss, one has ssskillsss.",
      "after": "Quem tem moedasss tem habilidadesss.",
      "before": "Se um tem moedasss, um tem habilidadesss.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-23363da888e2d0728e027e93"
    },
    {
      "EN": "If you gots the shinies, you gots ::family_size more goblins to steal it.",
      "after": "Se você tem coisas brilhantes, vai ter mais ::family_size goblins pra roubá-las.",
      "before": "Se você tem os brilhantes, você tem ::family_size goblins a mais pra roubar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-ec1cd828baf4aedbfff0572a"
    },
    {
      "EN": "If you insist, know this: I do not make warriors. I make survivors... barely.",
      "after": "Se insistir, saiba disto: não formo guerreiros. Formo sobreviventes... por pouco.",
      "before": "Se insistir, saiba disto: eu não faço guerreiros. Eu faço sobreviventes... mal.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-640ec9541149732b807e300f"
    },
    {
      "EN": "If you're up for the challenge, I'll take you under my wing.",
      "after": "Se você topar o desafio, eu coloco você sob minha proteção.",
      "before": "Se você topar o desafio, eu te levo sob minha asa.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4e854cf5e33267f7cc555ff4"
    },
    {
      "EN": "It is a fair trade.",
      "after": "É uma troca justa.",
      "before": "É uma troca justa",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7df6c4e08922d36a8aae56b6"
    },
    {
      "EN": "It isss not the bessst time.",
      "after": "Essste não é o melhor momento.",
      "before": "Essse não é o melhor momentoss.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-886aece03a033ea54f9674a0"
    },
    {
      "EN": "It will not be easssy, but I will try.",
      "after": "Não será fásssil, mas vou tentar.",
      "before": "Não será fásssil, mas vou tentar",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-3ac50ee5e0fa43c37ea64b22"
    },
    {
      "EN": "It'sss a good ssstuff.",
      "after": "Issso é coisa boa.",
      "before": "Issso é uma boa coisa",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4ee0124bd8003b40e407dd63"
    },
    {
      "EN": "It'sss sssomething to consssider if you could find me a perfect gift.",
      "after": "É algo a consssiderar, se você encontrar o presente perfeito para mim.",
      "before": "Ééé algo a consssiderar se você pudesse me encontrar um presente perfeito.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-f3ba23ccb308eee98f087e08"
    },
    {
      "EN": "Jussst don't overussse it.",
      "after": "Só não exagere no ussso.",
      "before": "Jusssst não exagere.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-de8acfd2ab0a537d6b64348e"
    },
    {
      "EN": "Keep it movin', before I decide to make you.",
      "after": "Continue andando, antes que eu obrigue você.",
      "before": "Continue andando, antes que eu decida te fazer.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4d23002510db97fd18946163"
    },
    {
      "EN": "Lookin' to temper some metal, are ya?",
      "after": "Tá querendo fazer a têmpera de um metal, é?",
      "before": "Tá querendo temperar metal, é?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-be0b366e6d9af877d815d86c"
    },
    {
      "EN": "Looking for sssome deliciousss meat?",
      "after": "Procurando carne deliciosssa?",
      "before": "Procurando por sssuma carne deliciosssa?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8e099b5cf9175b9d788d831b"
    },
    {
      "EN": "May the jungle always provide for us.",
      "after": "Que a selva sempre nos sustente.",
      "before": "Que a selva sempre nos forneça.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-63a99d31a1deec7fa7cd8cc0"
    },
    {
      "EN": "May the spirits watch over you and keep you safe.",
      "after": "Que os espíritos velem por você e o mantenham em segurança.",
      "before": "Que os espíritos velhem por você e o mantenham seguro.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-24479bfda6d51818d1421eea"
    }
  ],
