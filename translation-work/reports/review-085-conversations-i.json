{
  "corrections": [
    {
      "EN": "Power and very soul of The One created this world. And now He is bored of us and will come soon to take what's His. All will return to Him!",
      "after": "O poder e a própria alma do Uno criaram este mundo. E agora Ele está entediado conosco e virá em breve tomar o que é Dele. Tudo retornará a Ele!",
      "before": "O poder e a própria alma d'O Um criaram este mundo. E agora Ele está entediado conosco e virá em breve tomar o que é Dele. Tudo retornará a Ele!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-47684e4ecaf36b29f13f1bc2"
    },
    {
      "EN": "Scram.",
      "after": "Vaza.",
      "before": "Sumiu.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-14519a990eb808323e2170f5"
    },
    {
      "EN": "Sorry, I'm already married to ::spouse. Go away, before they see us together.",
      "after": "Desculpe, já tenho um casamento com ::spouse. Vá embora antes que essa pessoa nos veja aqui.",
      "before": "Desculpe, já sou casado com ::spouse. Vá embora, antes que nos vejam juntos.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8c90fa7345e3903856d3910c"
    },
    {
      "EN": "Ssshould I sssacriface my preciousss time to train you? Hmm... Well, I have nothing better to do right now.",
      "after": "Deveria eu sssacrificar meu tempo preciosssso para te treinar? Hmm... Bem, não tenho nada melhor para fazer agora.",
      "before": "Ddeveria eu ssacrificar meu tempo preciosso para te treinar? Hmm... Bem, não tenho nada melhor para fazer agora.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-eafac1c85623cf830c674d54"
    },
    {
      "EN": "Sssomebody ssshould learn sssome boundariesss...",
      "after": "Alguém deveria aprender algunsss limitesss...",
      "before": "Alguém deVERIA APRENDER ALGUNSsss LIMITESSS...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-f9ee879c061084753c6dfe83"
    },
    {
      "EN": "Sssomething I can help you with?",
      "after": "Posssso ajudar em algo?",
      "before": "Algo que eu possssa ajudar?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9c77af1018a9333d89165045"
    },
    {
      "EN": "Sssorry, I'm not interesssted in anything on the ssside.",
      "after": "Desssculpe, não tenho interessse em uma aventura por fora.",
      "before": "Deessculpe, não tenho interessse em nada por fora.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-bb3852b43576e0c0e402df5c"
    },
    {
      "EN": "Ssstop bothering me.",
      "after": "Pare de me incomodar, sssim?",
      "before": "P-pare de m-me incomodar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-acf3f54edcc02871c72475fe"
    },
    {
      "EN": "Sssure, I will be glad to help you. For a price.",
      "after": "Sssim, terei prazer em ajudar. Por um preço.",
      "before": "C-certo, ficarei feliz em ajudar. Por um preço.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b543f14cbc3e5dc735bb8c23"
    },
    {
      "EN": "Talk's cheap, work ain't.",
      "after": "Conversa é barata, trabalho não.",
      "before": "Conversa é barato, trabalho não.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-058d02e120d2bc26203bbf87"
    },
    {
      "EN": "Tassstes better if you cook it.",
      "after": "Fica maisss saboroso se cozinhar.",
      "before": "Fica sssaboroso se cozinhar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-66cb8ae238849bd2b13c6580"
    },
    {
      "EN": "Thank you for your interest, however my heart belongs to another.",
      "after": "Agradeço o interesse, mas meu coração pertence a outra pessoa.",
      "before": "Obrigado pelo interesse, mas meu coração pertence a outro.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-420721139776b12c02b4825b"
    },
    {
      "EN": "Thank you for your kind offer, but we shall remain in our home.",
      "after": "Agradecemos a generosa oferta, mas permaneceremos em nosso lar.",
      "before": "Obrigado pela generosa oferta, mas permaneceremos em nosso lar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-46b51e52085abbf04a12cdce"
    },
    {
      "EN": "Thanks for your business. These ingots will serve you well, I guarantee it.",
      "after": "Agradeço a preferência. Esses lingotes vão te servir bem, garanto.",
      "before": "Obrigado pela preferência. Esses lingotes vão te servir bem, garanto.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-edd5b761ee8ce7dcf9473062"
    },
    {
      "EN": "That beer will put hair on your chest!",
      "after": "Essa cerveja vai fazer crescer pelo no seu peito!",
      "before": "Essa cerveja vai colocar cabelo no seu peito!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-e8d9cfd1ca811b1324d856fd"
    },
    {
      "EN": "The One will come soon...",
      "after": "O Uno virá em breve...",
      "before": "O Um virá em breve...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-2ac375f18d20173b3976c2f4"
    },
    {
      "EN": "The armory stands nearly empty of serviceable gear.",
      "after": "O arsenal está quase vazio de equipamentos utilizáveis.",
      "before": "A armeria está quase vazia de equipamentos utilizáveis.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-9948aa4087b1fda4537827da"
    },
    {
      "EN": "The leavesss are ssso calm today, don't you think?",
      "after": "As folhasss estão tão calmas hoje, não acha?",
      "before": "As folhasss estão sssão calmas hoje, não acha?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-05020a114f40d37072118254"
    },
    {
      "EN": "The monument isss gone... or not yet raisssed.",
      "after": "O monumento desssapareceu... ou ainda não foi erguido.",
