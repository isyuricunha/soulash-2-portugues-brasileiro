      "id": "s2-e81d2f86072aa0c97f4d90e9"
    },
    {
      "EN": "Oh, you flatter me dear, but my heart belongs to ::spouse.",
      "after": "Ah, agradeço o elogio, mas meu coração pertence a ::spouse.",
      "before": "Oh, você me elogia, querida, mas meu coração pertence a ::spouse.",
