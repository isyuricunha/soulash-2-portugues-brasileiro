      "id": "s2-bba943d57a0fdf5854981bbb"
    },
    {
      "EN": "Not before sssky fallsss down.",
      "after": "Só quando o céu desssabar.",
      "before": "Não antecsss que o céu caisss.",
      "gender_after": null,
      "gender_before": null,
