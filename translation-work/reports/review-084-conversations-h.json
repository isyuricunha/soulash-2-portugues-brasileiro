    },
    {
      "EN": "Not going to happen. Find sssomeone elssse.",
      "after": "Não vai acontecer. Procure outra pesssoa.",
      "before": "Não vai acontecer. Encontre sssalguém mais.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-f1aadcd038d5a45d37fbcf90"
    },
    {
      "EN": "Not in the mood for conversation. Begone.",
      "after": "Sem vontade de conversar. Suma daqui.",
      "before": "Sem vontade de conversar. Sumam daqui.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-fd3cac0b8783e86bcab3d59c"
    },
    {
      "EN": "Not much to sssay yet.",
      "after": "Ainda não tenho muita coisssa a dizer.",
      "before": "Não tenho muito a dizzzerr ainda.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-4b3abfbf6ac14110d51098ec"
    },
    {
      "EN": "Not now! The frogsss are calling me.",
      "after": "Não agora! Os sssapos estão me chamando.",
      "before": "Não agora! Os sssapos estão me chamando",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6ce6717a3a3f780a911a25c5"
    },
    {
      "EN": "Of course, there isss ssso much to know about beesss! You want to hear about beesss, right?",
      "after": "Claro, há muitísssimo a saber sobre abelhasss! Quer ouvir sobre abelhasss, não quer?",
      "before": "Claro, tem muitisssimo o que saber sobre abelhasss! Quer ouvir sobre abelhasss, não quer?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-71d86128a9178ec9915415e5"
    },
    {
      "EN": "Of courssse. I just love teaching sssomeone my craft.",
      "after": "Claro. Adoro ensssinar meu ofício a alguém.",
      "before": "Clarossse. Adoro ensssinar a minha arte a aluguém.",
