    },
    {
      "EN": "Training a troll ain't for the faint-hearted, but I can show you.",
      "after": "Treinar um troll não é pros fracos, mas posso te mostrar.",
      "before": "Treinar troll não é pro fracos, mas posso te mostrar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7c6fdb81ec10795b71fab0b4"
    },
    {
      "EN": "Water can flow or it can crasssh.",
      "after": "A água pode fluir ou esssmagar.",
      "before": "A água pode fluir ou se espatifar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6d4d002315e84e0f0fc8b637"
    },
    {
      "EN": "We can bring some light into your life.",
      "after": "Podemos trazer um pouco de luz para sua vida.",
      "before": "Podemos trazer um pouco de luz para sua vida",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8dd4c208de7fbed54138cd6e"
    },
    {
      "EN": "We can help you learn something useful.",
      "after": "Podemos te ajudar a aprender algo útil.",
      "before": "Podemos te ajudar a aprender algo útil",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8eb66cf9439f5b94a675572e"
    },
    {
      "EN": "We can help you, if you have gold.",
      "after": "Podemos te ajudar, se você tiver ouro.",
      "before": "Podemos te ajudar, se você tiver ouro",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b8179e60582e705f0e68b8a3"
    },
    {
      "EN": "We don't know much, but we can teach you.",
      "after": "Não sabemos muito, mas podemos te ensinar.",
      "before": "Negociar mercadorias.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-0fb514bf2690dab912c0b8fa"
    },
    {
      "EN": "We don't think you have what it takes.",
      "after": "Não achamos que você tenha o que é preciso.",
      "before": "Não achamos que você tenha o que é preciso",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-cf533e2eee8ae7f74c4314fc"
    },
    {
      "EN": "We hope you are better student than a bat.",
      "after": "Esperamos que você seja um aluno melhor que um morcego.",
      "before": "Esperamos que você seja um aluno melhor que um morcego",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-ed5b7f15d4d2b94d1f48c066"
    },
    {
      "EN": "We hope you like it!",
      "after": "Esperamos que goste!",
      "before": "Esperamos que gostem!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d7d04ee55393f841d9e1f364"
    },
    {
      "EN": "We make sure Mycelium helps us all.",
      "after": "Garantimos que o Micélio ajude a todos nós.",
      "before": "Garantimos que o Mycelium nos ajude a todos.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d65ab10eefd2f80438087786"
    },
    {
      "EN": "We need fressssh bladesss and sssound armor to defend thisss possst.",
      "after": "Precisssamos de lâminas novas e armaduras resistentes para defender essste posssto.",
      "before": "Precisamos de lâmminas fresssscas e arrrmaduras sssólidas para defender esssse posssto.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-da875b12d99efa013871dc0a"
    },
    {
      "EN": "We ssstay in our homesss.",
      "after": "Ficamos em nossasss casssas.",
      "before": "Nós fficamos em nossasss cassas.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-cf723b0d2fb3c78a9c67d31a"
    },
    {
      "EN": "We think we can show you a thing or two.",
