{
  "corrections": [
    {
      "EN": "The storrrm is comming.",
      "after": "A torrrmenta tá chegando.",
      "before": "A tormmenta tá chegando.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-662dac19dd9c65cc7e3c6b68"
    },
    {
      "EN": "These woods be dangerous for the uninitiated!",
      "after": "Essas matas são perigosas para quem não as conhece!",
      "before": "Cuidado com os machados, eles são mais afiados do que parecem!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-a41728e3e19bae388bda6a88"
    },
    {
      "EN": "This is my part of the ssswamp! Find your own!",
      "after": "Esssa parte do pântano é minha! Encontre a sua!",
      "before": "Essa é minha parte do pântano! Encontre a sua!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-c5d31e13f71822d2bb237704"
    },
    {
      "EN": "Thissss issss our teritorry.",
      "after": "Essste é o nosssso território.",
      "before": "Isssso é nosso territórrio.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-676c50ea4df42e22f2bd8c9b"
    },
    {
      "EN": "Threads of fate entwined – let's see whose story prevails!",
      "after": "Os fios do destino se entrelaçam — vamos ver qual história prevalece!",
      "before": "Fios do destino entrelaçados – vamos ver cuja história prevalece!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6888d1c48e96c507061422f6"
    },
    {
      "EN": "Time to cut sssomething.",
      "after": "Hora de cortar alguma coisssa.",
      "before": "Hora de cortar algossso.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-fc4082e3d9830ad2114f084a"
    },
    {
      "EN": "Today we fight, tommorow we feasssst!",
      "after": "Hoje lutamos, amanhã nosss banquetesssamos!",
      "before": "Hoje lutamos, amanhã festaaaamos!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-f6b51792502b682c8c9fff43"
    },
    {
      "EN": "Troll game only for those who show respect!",
      "after": "Caça de troll só pra quem mostra respeito!",
      "before": "Jogo de troll só pra quem mostra respeito!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8c8ef5dabaa31c18d9a92eac"
    },
    {
      "EN": "Try to run. I could use the exercise.",
      "after": "Tente correr. Um pouco de exercício me faria bem.",
      "before": "Tente correr. Eu podia usar o exercício.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-aa177c7d27711aeb56cf20b2"
    },
    {
      "EN": "We think we lost one... Again..",
      "after": "Achamos que perdemos um... De novo...",
      "before": "Acho que perdemos mais um... De novo..",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b594b43bf6cee3882b49710a"
    },
    {
      "EN": "We will fight you until we can hold a weapon.",
      "after": "Lutaremos contra você enquanto conseguirmos empunhar uma arma.",
      "before": "Lutaremos contra você até podermos empunhar uma arma.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-0fe3f8d74730c6c98c9afb63"
    },
    {
      "EN": "We will pay the ultimate sacrifice if that is required to survive.",
      "after": "Faremos o sacrifício supremo se isso for necessário para sobreviver.",
      "before": "Pagaremos o sacrifício supremo se isso for necessário para sobreviver.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-70c013916b01fcf940148c5e"
    },
    {
      "EN": "WeHaveIncredibleMachinesThatWillTurnYouIntoChicken!",
      "after": "TemosMáquinasIncríveisQueVãoTeTransformarEmFrango!",
      "before": "TemosMáquinasIncrivéisQueVãoTeTransformarEmFrango!",
