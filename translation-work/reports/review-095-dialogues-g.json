    },
    {
      "EN": "Mind the axes, they're sharper than they seem!",
      "after": "Cuidado com os machados, são mais afiados do que parecem!",
      "before": "Essas matas são perigosas para os não iniciados!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-3cfd9dcfe9ba5e79587c491a"
    },
    {
      "EN": "Mind the pickaxes, they're a-swingin'!",
      "after": "Cuidado com as picaretas, estão em movimento!",
      "before": "Olha as picaretas, tão no balanço!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-fc1454c9836a51fd05eb1a8f"
    },
    {
      "EN": "My cabbages!",
      "after": "Meus repolhos!",
      "before": "Minhas couves!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-981716f3b2b0f5e040a0c8b0"
    },
    {
      "EN": "Mycelium will guid us all.",
      "after": "O Micélio guiará a todos nós.",
      "before": "O micélio nos guiará a todos.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-2114936b3c1f2fd403f95e27"
    },
    {
      "EN": "No, I got it. Thanksss.",
      "after": "Não, eu consssigo. Agradeço.",
      "before": "Não, eu consigo. Obrigadosss.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-aaba7c28f914a913b6e77366"
    },
    {
      "EN": "No, my cabbages!",
      "after": "Não, meus repolhos!",
