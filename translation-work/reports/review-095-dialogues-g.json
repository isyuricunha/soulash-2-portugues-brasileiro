      "gender_after": null,
      "gender_before": null,
      "id": "s2-11d2bd6e5d4f7d3590b653e2"
    },
    {
      "EN": "Oi! Troll forager's harvest ain't fer just anyone.",
      "after": "Oi! A colheita de um forrageador troll não é pra qualquer um.",
      "before": "Oi! Colheita de coletor troll não é pra qualquer um.",
