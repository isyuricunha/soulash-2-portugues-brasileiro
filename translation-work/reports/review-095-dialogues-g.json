      "id": "s2-150b6fe071ce48bb013d9a3e"
    },
    {
      "EN": "Oi, them cone-eaters will not make you such a fine apparel!",
      "after": "Oi, esses comedores de pinhas não vão te fazer uma roupa tão fina!",
      "before": "Oi, esses comedores de cone não vão te fazer uma roupa tão fina!",
