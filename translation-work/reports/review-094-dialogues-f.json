{
  "corrections": [
    {
      "EN": "I've seen so many diseases.",
      "after": "Já vi tantas doenças.",
      "before": "Já vi tantas doenças...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b7054dd5358281a9026e0811"
    },
    {
      "EN": "If ye can't beat me, Gannicus is goin' to reap ye apart.",
      "after": "Se não conseguir me vencer, Gannicus vai te despedaçar.",
      "before": "Se não me vencer, Gannicus vai te ceifar em pedaços.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8069a96d38242ccaff98d6a3"
    },
    {
      "EN": "Is that it? They said you're a god or some shit.",
      "after": "É só isso? Disseram que você era um deus ou alguma porra dessas.",
      "before": "É só isso? Disseram que você era um deus ou porra alguma.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-179f09e93a92a329dd441768"
    },
    {
      "EN": "It is for the best...",
      "after": "É melhor assim...",
      "before": "É para o melhor...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-3af55ff0fef227f5dd3479b6"
    },
    {
      "EN": "It issss you.",
      "after": "É você, sssim.",
      "before": "É vossssê.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8ce384dfe2f214dab158e513"
    },
    {
      "EN": "It ssstingsss.",
      "after": "Essstá ardendo.",
      "before": "Essssta ardendo...",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-7f74a823863ad3a73205b8b4"
    },
    {
      "EN": "It'sss a ssshame that you have to die.",
      "after": "É uma pena que você precissse morrer.",
      "before": "Ésss uma pena que você tenha que morrer.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-2ffb2f5f122231d89258f6d6"
    },
    {
      "EN": "Just wait and see... The One will be back.",
      "after": "Espere e verá... O Uno voltará.",
      "before": "Apenas espere e verá... Aquele voltará.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8be3171edcdce193a2944da3"
    },
    {
      "EN": "Kane is comin'. Ooh, Kane is comin'.",
      "after": "Kane tá chegando. Ooh, Kane tá chegando.",
      "before": "Caminho errado, porra, parceiro.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-8d12ee2248347ecbb43744b2"
    },
    {
      "EN": "Keeping warm. I hope they will hatch any day now.",
      "after": "Mantendo-os aquecidos. Espero que choquem a qualquer momento.",
      "before": "Mantendo-os aquecidos. Espero que choem a qualquer momento.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-525c8dda958a32e8c93b3237"
    },
    {
      "EN": "Let me show you the forbidden elven technique, Dance of Macabre.",
      "after": "Deixe-me mostrar a técnica élfica proibida: Dança Macabra.",
      "before": "Deixe-me mostrar a você a técnica élfica proibida, Dança do Macabro.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-e172db5468dc93fdfb451916"
    },
    {
      "EN": "Let's see how your destiny unravel!",
      "after": "Vamos ver como seu destino se desenrola!",
      "before": "Vamos ver como seu destino se desfaz!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-977621155eabfd9aeec9abc1"
    },
    {
      "EN": "Mae duw angof yma!",
      "after": "Mae duw angof yma!",
      "before": "Um deus esquecido está aqui!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d16029840bc84848ba49a518"
    },
    {
      "EN": "Mae haul coch yn codi",
      "after": "Mae haul coch yn codi",
      "before": "O sol vermelho nasce",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6bf40508998cabf29679e089"
    },
    {
      "EN": "Mae rhywbeth allan yna!",
      "after": "Mae rhywbeth allan yna!",
      "before": "Tem algo lá fora!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-d49ccf130bac0510318cc72d"
    },
    {
      "EN": "Maybe a bit o' target practice?",
      "after": "Que tal praticar tiro ao alvo?",
      "before": "Que tal uma praticazinha de alvo?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6e6dbc2910ae1a1997112030"
    },
    {
      "EN": "Me break bones!",
      "after": "Eu quebra osso!",
      "before": "Me quebro ossos!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-6cc219f945f8e3fe92a6f994"
    },
