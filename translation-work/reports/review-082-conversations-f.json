{
  "corrections": [
    {
      "EN": "I think you can use some training.",
      "after": "Acho que um pouco de treinamento faria bem a você.",
      "before": "Acho que você poderia usar um treinamento.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-67afec9dce4b90ba6d6c5f97"
    },
    {
      "EN": "I won't take you on board my ssship.",
      "after": "Não vou levar você a bordo, sssabe?",
      "before": "Não vou levar você a bordo do meu navio!",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-62dc1590fe08f0c563705892"
    },
    {
      "EN": "I'm a bit busy at the moment.",
      "after": "Estou sem muito tempo no momento.",
      "before": "Pedir treinamento.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-12db82bec0807165e91cf684"
    },
    {
      "EN": "I'm afraid I'm not much of a conversationalist.",
      "after": "Receio que eu não seja muito de conversar.",
      "before": "Receio que não sou muito de conversar.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-717deecad94c5744c61e1a88"
    },
    {
      "EN": "I'm afraid I'm too busy with my own projects right now to take on a student.",
      "after": "Receio que esteja ocupado demais com meus próprios projetos no momento para aceitar um aluno.",
      "before": "Receio que estou ocupado demais com meus próprios projetos no momento para aceitar um aluno.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-e511928155bf1b7a6e7a909b"
    },
    {
      "EN": "I'm busssy, cant you sssee?",
      "after": "Esstou sem tempo, não vê?",
      "before": "Tô ocupsssado, não tá vendo?",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-fa77a11c7687c5a0351d6e55"
    },
    {
      "EN": "I'm not in the mood for that.",
      "after": "Não estou com vontade de fazer isso.",
      "before": "Não estou com vontade para isso.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-c14c0002142b3e485b311d28"
    },
    {
      "EN": "I'm sssure you can find sssomeone better.",
      "after": "Tenho certeza de que você consssegue encontrar alguém melhor.",
      "before": "Estou sssseguro que você pode enconssstrar alguém melhor.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-782c09778b2cdb2da814e4eb"
    },
    {
      "EN": "I'm taken. But when this one dies... We can see.",
      "after": "Já tenho alguém. Mas quando essa pessoa morrer... A gente vê.",
      "before": "Já tenho alguém. Mas quando este morrer... A gente vê.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-b6c5556b0e1afcde4d8afdbb"
    },
    {
      "EN": "I'm way too cold and way too tired to think about anyone but ::spouse.",
      "after": "Estou com tanto frio e tanto cansaço que só consigo pensar em ::spouse.",
      "before": "Estou com muito frio e cansado demais para pensar em ninguém além de ::spouse.",
      "gender_after": null,
      "gender_before": null,
      "id": "s2-82100fba67fbdfe08afb15a8"
    },
    {
      "EN": "I've crosssed mountainsss to get here. What'sss your ssstory?",
      "after": "Atravessei montanhasss para chegar aqui. Qual é a sua hisstória?",
